---
/* Signature viewer: one ShellForm design cell, the seismic-aware form coloured by its
   height change from the gravity-only form. The page shows a still render of the same
   model; three.js loads only when the reader asks for the 3D view, so it costs nothing
   on page load and never captures touch scrolling uninvited. Without WebGL the still stays. */
import { getImage } from 'astro:assets';
import fallback from '../assets/media/shellform/viewer-fallback.png';
import cell from '../assets/models/shellform-cell.json';

const img = await getImage({ src: fallback, width: 1600, format: 'webp' });
const lim = Math.round(cell.dz_limit_mm);
---

<figure class="fig shell-viewer">
  <div class="viewer" data-viewer data-ready="false">
    <img class="fallback" src={img.src} width="1600" height="1000" alt={`Thin concrete shell on four corner supports, ${cell.span_m} m span, coloured by how much the seismic-aware form rises or drops relative to the gravity-only form; the largest change is about ${lim} millimetres.`} loading="lazy" decoding="async" />
    <div class="controls no-print">
      <button type="button" class="load" data-load hidden>Rotate in 3D</button>
      <button type="button" data-reset hidden>Reset view</button>
    </div>
    <span class="hint no-print" data-hint hidden>Drag to orbit · scroll or pinch to zoom</span>
  </div>
  <div class="legend" aria-hidden="true">
    <span>−{lim} mm</span><span class="bar"></span><span>+{lim} mm</span>
  </div>
  <figcaption>
    <span class="label">ShellForm · {cell.id.replace('-seismic-sa0.6', '')}</span>
    Seismic-aware form at S<sub>a</sub> = {cell.sa_g} g, coloured by height change from the gravity-only form (blue lower,
    red higher; scale ±{lim} mm; in this cell no node drops). {cell.span_m} m span, corner supports, rise/span {cell.rise_ratio}. Data: ShellForm v0.1.0, tag {cell.freeze_tag}, on ShellBench {cell.shellbench_tag}.
  </figcaption>
</figure>

<script>
  const host = document.querySelector<HTMLElement>('[data-viewer]');
  if (host) {
    const gl = (() => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    })();
    const start = () =>
      import('./viewer')
        .then((m) => { m.mount(host); host.querySelector<HTMLButtonElement>('[data-reset]')?.focus({ preventScroll: true }); })
        .catch(() => (host.dataset.ready = 'false'));

    if (gl) {
      const btn = host.querySelector<HTMLButtonElement>('[data-load]')!;
      btn.hidden = false;
      btn.addEventListener('click', () => { btn.hidden = true; start(); }, { once: true });
    }
  }
</script>
