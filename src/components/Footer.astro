---
import Email from './Email.astro';
import { site, links } from '../lib/site';
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="wrap">
    {
      path !== '/contact/' && (
        <section class="cta-band" aria-labelledby="cta-h">
          <div>
            <span class="eyebrow"><span class="cm" aria-hidden="true">#</span>Contact</span>
            <h2 id="cta-h">Get in touch</h2>
            <p>{site.currently}</p>
          </div>
          <div class="cta">
            <Email label="Email me" />
            <a class="btn" href={site.cv_pdf}>CV (PDF)</a>
            <a class="btn" href="/contact/">All contact details</a>
          </div>
        </section>
      )
    }
    <div class="foot">
      <div>
        <p class="who">{site.name}</p>
        <p class="muted">{site.job_title}, {site.location}</p>
      </div>
      <div>
        <ul>
          <li><Email /></li>
          <li><a href={links.orcid} rel="me">ORCID</a></li>
          <li><a href={links.github} rel="me">GitHub</a></li>
          <li><a href={links.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={links.researchgate} rel="me">ResearchGate</a></li>
        </ul>
      </div>
      <div>
        <p class="fine">
          © {year} {site.name}. Figures come from the linked project repositories, under their licences.
          <a href="https://github.com/syednafizreja/syednafizreja.github.io">Site source</a>.
        </p>
      </div>
    </div>
  </div>
</footer>
