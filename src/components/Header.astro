---
import { Image } from 'astro:assets';
import { site, links } from '../lib/site';
import portrait from '../assets/media/portrait.jpg';

const nav = [
  { href: '/work/', label: 'Work', icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
  { href: '/research/', label: 'Research', icon: 'M9.5 3.5h5M10.5 3.5v5.2L5 18.4A1.4 1.4 0 0 0 6.2 20.5h11.6a1.4 1.4 0 0 0 1.2-2.1l-5.5-9.7V3.5M7.6 14h8.8' },
  { href: '/publications/', label: 'Publications', icon: 'M6 3.5h8.5l3.5 3.5v13.5H6zM9 11h6M9 14.5h6M9 18h3.5' },
  { href: '/about/', label: 'About', icon: 'M12 12a3.8 3.8 0 1 0 0-7.6 3.8 3.8 0 0 0 0 7.6ZM4.5 20.5c.9-3.8 3.9-6 7.5-6s6.6 2.2 7.5 6' },
  { href: '/cv/', label: 'CV', icon: 'M7 3.5h7l3.5 3.5V20.5H7zM10 11h5M10 14.5h5M10 18h3' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => path === href || path.startsWith(href);
const initials = site.name.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('');
---

<header class="site-header">
  <div class="topbar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">{initials}</span>
      <span class="name">{site.name}</span>
    </a>
    <div class="top-actions">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <button class="scrim" type="button" data-scrim hidden aria-label="Close menu"></button>
  <div class="bar" id="site-drawer">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">{initials}</span>
      <span class="avatar" aria-hidden="true"><Image src={portrait} alt="" widths={[112, 224]} sizes="112px" loading="lazy" decoding="async" /></span>
      <span class="name">{site.name}</span>
    </a>
    <p class="role">{site.job_title}</p>
    <nav class="nav" aria-label="Main">
      {
        nav.map((item, i) => (
          <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
            <span class="i" aria-hidden="true">{String(i).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="actions">
      <a class="pill" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a>
    </div>
    <ul class="social">
      <li><a href={links.orcid} rel="me">ORCID</a></li>
      <li><a href={links.github} rel="me">GitHub</a></li>
      <li><a href={links.linkedin} rel="me">LinkedIn</a></li>
      <li><a href="/cv/">CV</a></li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const drawer = document.getElementById('site-drawer');
  const scrim = header?.querySelector<HTMLButtonElement>('[data-scrim]');
  const wide = matchMedia('(min-width: 64.0625rem)');
  const setOpen = (open: boolean) => {
    if (!header || !btn) return;
    const show = open && !wide.matches;
    header.classList.toggle('is-open', show);
    btn.setAttribute('aria-expanded', String(show));
    btn.setAttribute('aria-label', show ? 'Close menu' : 'Open menu');
    if (scrim) scrim.hidden = !show;
    document.body.classList.toggle('nav-open', show);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  scrim?.addEventListener('click', () => setOpen(false));
  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  wide.addEventListener('change', () => setOpen(false));
</script>
