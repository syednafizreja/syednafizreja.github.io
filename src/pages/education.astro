---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import edu from '../data/education.json';
// Facts live in src/data/education.json and are shared with the resume page.
---

<Base title="Education" description={`Education of ${site.name}: BEng Civil Engineering, Southwest Petroleum University, on a full Chinese Government Scholarship.`}>
  <header class="page-head wrap">
    <span class="eyebrow"><span class="cm" aria-hidden="true">#</span>Education</span>
    <h1>Education</h1>
    <p class="lede">A four-year civil engineering degree in China on a full government scholarship, ending in a thesis that designed a reinforced concrete frame by hand.</p>
  </header>

  <div class="wrap cv section">
    <section>
      <h2>Degrees</h2>
      <div>
        {edu.degrees.map((d) => (
          <div class="entry">
            <div class="entry-head"><h3>{d.title}</h3><span class="when">{d.when}</span></div>
            <p class="where">{d.where}</p>
            {d.points.length > 0 && (
              <ul>
                {d.points.map((t) => <li>{t}</li>)}
                {d.link && <li><a href={d.link.href}>{d.link.label}</a>.</li>}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
    <section>
      <h2>Scholarship</h2>
      <p>{edu.awards}</p>
    </section>
    <section>
      <h2>Further courses</h2>
      <div><ul>{edu.courses.map((c) => <li>{c}</li>)}</ul></div>
    </section>
    <section>
      <h2>Languages</h2>
      <p>{edu.languages}</p>
    </section>
    <p class="mt-3"><a class="btn" href="/cv/">Full resume</a></p>
  </div>
</Base>
