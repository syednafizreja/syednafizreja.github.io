---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { site, links, PUB_STATUS_LABEL } from '../lib/site';
import edu from '../data/education.json';

const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const cite = (d: (typeof pubs)[number]['data']) => {
  const list = d.authors.length > 1 ? `${d.authors.slice(0, -1).join(', ')}, & ${d.authors.at(-1)}` : d.authors[0];
  const authors = list.replace(/\s+$/, '');
  // Authors already end with the period after the final initial. A missing year must not add a second one.
  const head = d.year ? `${authors} (${d.year}).` : `${authors.replace(/\.$/, '')}.`;
  return { head };
};
---

<Base title="Resume" description={`Resume (curriculum vitae) of ${site.name}: education, research projects, publications, experience and skills.`} og="cv">
  <header class="page-head wrap">
    <span class="eyebrow no-print"><span class="cm" aria-hidden="true">#</span>Resume</span>
    <h1>{site.name}</h1>
    <p class="lede">Civil engineer · computational mechanics of materials and structures · constitutive modelling · seismic design · embodied carbon. {site.location}.</p>
    <p class="lede contact-line"><span><Email /> ·</span> <span>ORCID <a href={links.orcid}>{site.orcid}</a> ·</span> <span><a href={links.github}>github.com/{site.github}</a></span></p>
    <div class="cv-actions">
      <a class="btn primary" href={site.cv_pdf} download>Download PDF</a>
      <button class="btn" type="button" onclick="window.print()">Print</button>
    </div>
  </header>

  <div class="wrap cv mt-4">
    <section>
      <h2>Profile</h2>
      <div>
        <p>{site.identity}</p>
        <p class="mt-2">{site.bio}</p>
      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div>
        {edu.degrees.map((d) => (
          <div class="entry">
            <div class="entry-head"><h3>{d.title}</h3><span class="when">{d.when}</span></div>
            <p class="where">{d.where}</p>
            {d.points.length > 0 && (
              <ul>
                {d.points.map((t) => <li>{t}</li>)}
                {d.link && <li><a href={d.link.href}>{d.link.label}</a>.</li>}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Research projects</h2>
      <div>
        <div class="entry">
          <div class="entry-head"><h3><a href="https://github.com/syednafizreja/diaphragm-rom-seismic">Reduced-order diaphragm stiffness in nonlinear seismic analysis</a></h3><span class="when">Nov 2026</span></div>
          <p class="where">Lead researcher · CalculiX 2.23 S8R, OpenSeesPy · Engineering Structures, submitted, ENGSTRUCT-D-26-12924</p>
          <ul>
            <li>605 OpenSeesPy fiber-section NLTHA runs (588 converged, 97.19%) on 7 RC archetypes and 11 ESM 3.0 records, at 0.25 g and 0.35 g. Dataset 10.5281/zenodo.24598960.</li>
            <li>A rigid diaphragm underpredicts mid-span drift by -36.1% to -57.1%. W-locking (2.40x) underpredicts by -8.0% to -27.0%. The X-strut (0.887x) stays conservative. A 2-DOF CQC law reaches R^2 = 0.715 (RMSE 11.42 percentage points).</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/diagrid-seismic-opt/">Diagrid seismic optimisation</a>: superelastic NiTi fuses against yielding steel</h3><span class="when">2026</span></div>
          <p class="where">Lead researcher and developer · Python, OpenSeesPy, scikit-learn, PyTorch · MIT licence</p>
          <ul>
            <li>1D Auricchio–Sacco NiTi constitutive driver with exact consistent tangent (&lt; 1e-7) and Clausius–Duhem dissipation monitoring.</li>
            <li>3D OpenSeesPy 0.40 g nonlinear time-history with P-Delta beam-column frames and corotational truss fuses (SelfCentering NiTi vs Steel02).</li>
            <li>80-design LHS, grouped-CV Matérn-5/2 GP (0% held-out false-safe rate at 95% UCB), 8 NSGA-II certified Pareto designs, PyTorch inverse ID.</li>
            <li>Residual drift 0.0659% to 0.0175%. Peak drift 1.79% to 3.40%. Carbon +620.9 kgCO2e.</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/stress-line-ribs/">Stress-line ribs vs optimised thickness</a></h3><span class="when">2026</span></div>
          <p class="where">Lead researcher and developer · Python, CalculiX, Gmsh · MIT licence</p>
          <ul>
            <li>Seven designs of one 12 × 12 m form-found shell, equal concrete volume, linear buckling under self-weight plus 0.2 g sway, then a geometric imperfection.</li>
            <li>Pre-registered hypothesis not supported: stress-line ribs fall 31.10% below the plain shell. Orthogonal grid gains 16.05%, optimised thickness 25.74% (15.03% with imperfection).</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/shellform/">ShellForm</a>: the carbon cost of seismic resilience in form-found concrete shells</h3><span class="when">2026</span></div>
          <p class="where">Lead researcher and developer · Python, CalculiX, three.js · MIT licence</p>
          <ul>
            <li>168 feasible designs (84 gravity-only and seismic-aware pairs, 0 to 0.6 g) and 125 automated tests. Dataset 10.5281/zenodo.24281917.</li>
            <li>79 pairs from the set of 84 stay within 5% carbon. Linear buckling governs all 84 corner-supported shells. The 50 mm minimum thickness governs all 84 edge-supported shells. Five crossings are one 5 mm step at lambda_1 = 5.0, absent on the 61x61 mesh and at lambda &gt;= 3 or lambda = 8. Formwork is a separate cost and can move a close comparison. Submitted to Structures.</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/shellbench/">ShellBench</a>: embodied carbon of thin-shell floors in seismic RC frames</h3><span class="when">2026</span></div>
          <p class="where">Lead researcher and developer · Python, OpenSeesPy, CalculiX · MIT licence</p>
          <ul>
            <li>Audited my thesis as the validation case: 16 input inconsistencies and 21 doubtful printed values logged, each with a recorded decision.</li>
            <li>Rebuilt the thesis frame in OpenSeesPy under gravity, wind and earthquake, with GB 50010 member checks and automated tests on every change.</li>
            <li>Released as v1.0.0. 5,184 designs across 36 seismic RC frames, 287 automated tests. Dataset 10.5281/zenodo.24194144. With the editor at Journal of Building Engineering, manuscript JBE-D-26-22324.</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/shelllab/">ShellLab: force-density form finding for concrete shells, in the browser</a></h3><span class="when">2026</span></div>
          <p class="where">Independent computational design project · JavaScript, three.js, Python</p>
          <ul><li>Browser port of the ShellForm form finder with live bar forces, support thrust and concrete carbon; tested against ShellForm fixtures to 1e-9 m.</li></ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3><a href="/work/pavecarbon/">PaveCarbon</a>: from laboratory durability to annualised pavement carbon</h3><span class="when">2025–2026</span></div>
          <p class="where">Independent research, sole author · Python, LCA</p>
          <ul>
            <li>Axisymmetric Q9 FEA + mechanistic-empirical fatigue/rutting + annualised A1–A3 LCA of nano-silica WMA; 1,500 Monte Carlo runs.</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <h2>Publications</h2>
      <div>
        <ol class="cv-pubs">
          {
            pubs.map((p) => {
              const d = p.data;
              const { head } = cite(d);
              return (
                <li value={d.order}>
                  {head} {d.title}.{' '}
                  {d.type === 'journal' ? (
                    <em>{d.venue}, {d.volume}{d.issue && `(${d.issue})`}{d.pages && `, ${d.pages}`}.</em>
                  ) : (
                    <span class="muted">{PUB_STATUS_LABEL[d.status]}{(d.status === 'under-review' || d.status === 'submitted' || d.status === 'with-editor') && d.venue ? `, ${d.venue}` : ''}{d.manuscript_id ? ` (${d.manuscript_id})` : ''}{d.note ? `. ${d.note}` : '.'}</span>
                  )}
                  {d.doi && <> <a href={`https://doi.org/${d.doi}`}>doi:{d.doi}</a></>}
                </li>
              );
            })
          }
        </ol>
        <p class="mt-2 no-print"><a href="/publications/">Publications with BibTeX</a></p>
      </div>
    </section>

    <section>
      <h2>Experience</h2>
      <div>
        <div class="entry">
          <div class="entry-head"><h3>Project and quality-control engineer, precision manufacturing</h3><span class="when">Jan 2024 – Mar 2026</span></div>
          <p class="where">Guangdong, China</p>
          <ul>
            <li>Cyclic-durability testing of superelastic NiTi, micro-CNC metrology, and failure analysis.</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head"><h3>Independent research collaborator</h3><span class="when">2024–</span></div>
          <p class="where">Informal collaboration with a PhD researcher at Hohai University · remote</p>
          <ul><li>Co-authored peer-reviewed reviews on BIM and on nano-additives in asphalt; wrote Python durability models and ran cradle-to-gate LCAs.</li></ul>
        </div>
      </div>
    </section>

    <section>
      <h2>Skills</h2>
      <div>
        <ul>
          <li>OpenSeesPy, CalculiX, Python/PyTorch, Gmsh, Three.js, LaTeX.</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Courses</h2>
      <div>
        <ul>{edu.courses.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2>Languages</h2>
      <p>{edu.languages}</p>
    </section>

    <section>
      <h2>Service</h2>
      <div>
        <div class="entry">
          <div class="entry-head"><h3>Senior ESL instructor and event coordinator, Foreign Language Corner</h3><span class="when">2019–2023</span></div>
          <p class="where">Southwest Petroleum University, Chengdu</p>
        </div>
        <div class="entry">
          <div class="entry-head"><h3>Member, Institution of Engineers, Bangladesh</h3><span class="when">2023–</span></div>
        </div>
      </div>
    </section>

    <section>
      <h2>Awards</h2>
      <p>{edu.awards}</p>
    </section>

    <section>
      <h2>References</h2>
      <p>Available on request.</p>
    </section>
  </div>
</Base>

<style>
  .contact-line > span { display: inline-block; }
  .cv-pubs { padding-left: 2.2em; }
  .cv-pubs li { font-size: 0.95rem; }
  .cv-pubs li + li { margin-top: 0.4rem; }
  .cv-pubs a { word-break: break-all; }
</style>
