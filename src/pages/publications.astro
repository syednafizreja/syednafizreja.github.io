---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { toBibtex } from '../lib/bibtex';
import { site, doiUrl, links } from '../lib/site';

const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  {
    title: 'Preprints and under review',
    id: 'open',
    match: (status: string, doi = '') => status === 'under-review' || (status === 'preprint' && doi.startsWith('10.5281/zenodo.245')),
  },
  {
    title: 'Earlier peer-reviewed articles',
    id: 'journal',
    match: (status: string) => status === 'published',
  },
] as const;
const projects = await getCollection('projects');
const projectRepo = (id?: string) => projects.find((p) => p.id === id)?.data.evidence.repo;
const badge = (status: string, year?: number) => {
  if (status === 'under-review') return 'UNDER REVIEW';
  if (status === 'preprint') return `${year ?? ''} PREPRINT`.trim();
  if (status === 'published') return `${year ?? ''} JOURNAL`.trim();
  return status;
};
---

<Base title="Publications" description="Peer-reviewed journal articles, manuscripts in preparation, and archived technical reports and preprints, with DOIs and BibTeX." og="publications">
  <header class="page-head wrap">
    <span class="eyebrow"><span class="cm" aria-hidden="true">#</span>Publications</span>
    <h1>Publications</h1>
    <p class="lede">DOIs are on each line. ORCID <a href={links.orcid}>{site.orcid}</a>.</p>
  </header>

  <div class="wrap mt-5">
    {
      groups.map((g) => {
        const items = pubs.filter((p) => g.match(p.data.status, p.data.doi ?? ''));
        return items.length ? (
          <section class="pub-group" aria-labelledby={`g-${g.id}`}>
            <h2 id={`g-${g.id}`}>{g.id === 'open' ? 'Preprints and under review' : 'Earlier peer-reviewed articles'}</h2>
            <ol class="pubs">
              {items.map((p) => {
                const d = p.data;
                const bibId = `bib-${p.id}`;
                const code = projectRepo(d.project);
                return (
                  <li class="pub">
                    <span class="badge">{badge(d.status, d.year)}</span>
                    <div>
                      <p class="t">{d.title}</p>
                      <p class="a">
                        {d.authors.map((a, i) => (
                          <>
                            {i > 0 && (i === d.authors.length - 1 ? ', & ' : ', ')}
                            {i + 1 === d.owner_index ? <span class="me">{a}</span> : a}
                          </>
                        ))}
                        {d.venue && <span class="v">. {d.venue}</span>}
                        {d.note && <span class="note">. {d.note}</span>}
                      </p>
                      <div class="row">
                        {d.doi && <a class="pill-link" href={doiUrl(d.doi)}>DOI</a>}
                        {code && <a class="pill-link" href={code}>Code</a>}
                        {d.url && <a class="pill-link" href={d.url}>PDF</a>}
                        <button class="copy-btn no-print" type="button" data-copy={bibId}>BibTeX</button>
                      </div>
                      <pre id={bibId} hidden>{toBibtex(d, p.id)}</pre>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ) : null;
      })
    }
  </div>
</Base>
