---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import { site, links } from '../lib/site';
import { byOrder } from '../lib/pubs';

const pubs = byOrder(await getCollection('publications'));
const projects = await getCollection('projects');
---

<Base title="Publications" description="Peer-reviewed journal articles, submitted manuscripts, preprints, and work in preparation, with DOIs and BibTeX." og="publications">
  <header class="page-head wrap">
    <span class="eyebrow"><span class="cm" aria-hidden="true">#</span>Publications</span>
    <h1>Publications</h1>
    <p class="lede">Status is the status of the record. A manuscript with an editor is not a published paper. A dataset DOI is labelled as a dataset. ORCID <a href={links.orcid}>{site.orcid}</a>.</p>
  </header>

  <div class="wrap mt-5">
    <PubList pubs={pubs} projects={projects} bibtex />
  </div>
</Base>
