---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <header class="page-head wrap">
    <span class="eyebrow"><span class="cm" aria-hidden="true">#</span>Error 404</span>
    <h1>This page does not exist.</h1>
    <pre class="traceback" aria-hidden="true"><code>Traceback (most recent call last):
  File "site.py", line 404, in &lt;module&gt;
    page = open(request.path)
FileNotFoundError: [Errno 2] No such file or directory: '<span data-missing-path>/missing/</span>'</code></pre>
    <p class="lede">It may have moved. Try the <a href="/work/">project index</a>, the <a href="/publications/">publications</a> or the <a href="/">home page</a>.</p>
    <p class="mt-3 muted">Looking for the canopy carbon tool? It lives at <a href="/parametric-canopy-carbon-optimization/">/parametric-canopy-carbon-optimization/</a>.</p>
  </header>
</Base>

<script>
  const el = document.querySelector('[data-missing-path]');
  if (el) el.textContent = location.pathname;
</script>
