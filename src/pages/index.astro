---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IndexRow from '../components/IndexRow.astro';
import ShellViewer from '../components/ShellViewer.astro';
import { site } from '../lib/site';
import cell from '../assets/models/shellform-cell.json';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.number.localeCompare(b.data.number));
const pubs = await getCollection('publications');
const featured = site.featured.map((id) => projects.find((p) => p.id === id)).filter((p) => p !== undefined);

// Short phrases for the core skills; the typewriter in mesh.ts loops through them.
const words = ['structural forms', 'shells under earthquakes', 'finite-element models', 'low-carbon structures'];
---

<Base description={site.identity}>
  <section class="hero" aria-labelledby="hero-h">
    <canvas class="mesh" data-mesh aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="railed hero-in">
        <p class="marker"><span class="cm" aria-hidden="true">#</span><span class="n">00</span>Start</p>
        <h1 id="hero-h" class="statement">
          <span class="l">Hi, I am <span class="who">{site.name}</span>.</span>
          <span class="l">I <em class="serif">design</em> and <span class="mono">analyse</span></span>
          <span class="l rot-line"><span class="sr-only">{words[0]}.</span><span class="rot" aria-hidden="true" data-rotate={JSON.stringify(words)}>{words[0]}</span><span class="caret" aria-hidden="true"></span></span>
        </h1>
        <button class="rot-pause" type="button" data-rot-pause hidden>Pause typing</button>
        <p class="identity">{site.identity}</p>
        <p class="chip"><span class="dot" aria-hidden="true"></span><span><strong>Now:</strong> {site.currently}</span></p>
        <div class="cta">
          <a class="btn primary" href="/work/">See the work <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href="/research/">Research statement</a>
          <a class="btn" href={site.cv_pdf}>Resume (PDF)</a>
        </div>
        <a class="scroll-cue" href="#sig" aria-hidden="true" tabindex="-1"><span class="mouse"><span></span></span><span class="t">Scroll</span></a>
      </div>
      <dl class="stats">
        <div><dt>projects with automated tests</dt><dd>{projects.filter((p) => p.data.evidence.tests).length}</dd></div>
        <div><dt>releases archived with a DOI</dt><dd>{projects.filter((p) => p.data.evidence.doi).length}</dd></div>
        <div><dt>project case studies</dt><dd>{projects.length}</dd></div>
        <div><dt>papers, manuscripts and reports</dt><dd>{pubs.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="sig">
    <div class="railed">
      <div class="section-head"><div><span class="idx"><span class="cm" aria-hidden="true">#</span> 01 · Method in focus</span><h2 id="sig">Finding a shell's form under earthquake load</h2></div></div>
      <div class="feature">
        <div>
          <ShellViewer />
          <dl class="titleblock plate">
            <div><dt>Span</dt><dd>{cell.span_m} m</dd></div>
            <div><dt>Supports</dt><dd>{cell.supports}</dd></div>
            <div><dt>Rise / span</dt><dd>{cell.rise_ratio.toFixed(2)}</dd></div>
            <div><dt>S<sub>a</sub></dt><dd>{cell.sa_g} g</dd></div>
            <div><dt>Mesh</dt><dd>{cell.n} × {cell.n} nodes</dd></div>
            <div><dt>Loads</dt><dd>gravity + seismic</dd></div>
          </dl>
        </div>
        <div class="prose">
          <p>
            ShellForm finds the shape of a thin concrete shell twice: once under gravity alone, and once with an earthquake load
            included. Each form is then sized by finite-element analysis against its design checks, buckling among them, and its embodied
            carbon is counted. The study sweeps span, supports, rise and seismic demand.
          </p>
          <p>
            The model on the left is one design cell. Its colours show where the earthquake-aware form departs from the
            gravity-only one. Finite-element mechanics and carbon accounting run through most of the other projects too.
          </p>
          <p><a class="btn" href="/work/shellform/">Read the ShellForm case study <span class="arr" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="sel">
    <div class="railed">
      <div class="section-head">
        <div><span class="idx"><span class="cm" aria-hidden="true">#</span> 02 · Projects</span><h2 id="sel">Selected work</h2></div>
        <a href="/work/">All {projects.length} projects →</a>
      </div>
      <ol class="index">
        {featured.map((p) => <IndexRow project={p} />)}
      </ol>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="how">
    <div class="railed">
      <div class="section-head"><div><span class="idx"><span class="cm" aria-hidden="true">#</span> 03 · Method</span><h2 id="how">How I work</h2></div></div>
      <div class="now">
        <div>
          <span class="label">A · Check first</span>
          <p>Every model is tested against a closed-form solution, a published benchmark or my own hand-designed thesis before it is used.</p>
        </div>
        <div>
          <span class="label">B · State the limits</span>
          <p>Each case study ends with what the work does not show: scope, assumptions and what is still pre-release.</p>
        </div>
        <div>
          <span class="label">C · Open by default</span>
          <p>Code, data and figures are public, tagged and archived, so every number on this site can be traced to a file.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/mesh';
</script>
