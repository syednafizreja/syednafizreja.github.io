---
import Base from '../layouts/Base.astro';
import { home, type SectionId } from '../lib/home';
import Hero from '../components/home/Hero.astro';
import ResearchMap from '../components/home/ResearchMap.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Method from '../components/home/Method.astro';
import Outputs from '../components/home/Outputs.astro';
import Tools from '../components/home/Tools.astro';
import AboutBand from '../components/home/AboutBand.astro';

const registry: Record<SectionId, typeof Hero> = {
  hero: Hero,
  map: ResearchMap,
  work: SelectedWork,
  method: Method,
  outputs: Outputs,
  tools: Tools,
  about: AboutBand,
};

const shown = home.sections.filter((section) => section.enabled);
---

<Base description={home.hero.focus}>
  {
    shown.map((section, i) => {
      const Section = registry[section.id];
      const index = String(section.id === 'hero' ? 0 : shown.slice(0, i).filter((s) => s.id !== 'hero').length + 1).padStart(2, '0');
      return <Section index={index} />;
    })
  }
</Base>
