---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IndexRow from '../components/IndexRow.astro';
import ShellViewer from '../components/ShellViewer.astro';
import { site } from '../lib/site';
import cell from '../assets/models/shellform-cell.json';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.number.localeCompare(b.data.number));
const pubs = await getCollection('publications');
const peerReviewed = pubs.filter((p) => p.data.type === 'journal' && p.data.status === 'published').length;
const featured = site.featured.map((id) => projects.find((p) => p.id === id)).filter((p) => p !== undefined);

// Short phrases for the core skills; the typewriter in mesh.ts loops through them.
---

<Base description={site.identity}>
  <section class="hero" aria-labelledby="hero-h">
    <canvas class="mesh" data-mesh aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="railed hero-in">
        <p class="kicker">Computational structural mechanics</p>
        <h1 id="hero-h" class="statement">
          <span class="l">{site.identity}</span>
        </h1>
        <p class="identity">{site.bio}</p>
        <div class="cta">
          <a class="btn primary" href="#preprints">Read preprints</a>
          <a class="btn" href="#research">Selected research</a>
        </div>
        <div class="latest" id="preprints">
          <a href="https://doi.org/10.5281/zenodo.24559613">
            <span class="k">Preprint · Zenodo DOI</span>
            <strong>1D superelastic NiTi return map and diagrid seismic-carbon trade-offs</strong>
            <span class="m">1.85e-10 tangent error · 80 paired canopies</span>
          </a>
          <a href="https://doi.org/10.5281/zenodo.24560903">
            <span class="k">Preprint · Zenodo DOI</span>
            <strong>Buckling and imperfection sensitivity of form-found thin concrete shells</strong>
            <span class="m">Scordelis-Lo/Zoelly verified · 7 equal-volume layouts</span>
          </a>
        </div>
      </div>
      <dl class="stats">
        <div><dt>projects with automated tests</dt><dd>{projects.filter((p) => p.data.evidence.tests).length}</dd></div>
        <div><dt>releases archived with a DOI</dt><dd>{projects.filter((p) => p.data.evidence.doi).length}</dd></div>
        <div><dt>project case studies</dt><dd>{projects.length}</dd></div>
        <div><dt>peer-reviewed journal articles</dt><dd>{peerReviewed}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="sig">
    <div class="railed">
      <div class="section-head"><div><span class="idx"><span class="cm" aria-hidden="true">#</span> 01 · Method in focus</span><h2 id="sig">Finding a shell's form under earthquake load</h2></div></div>
      <div class="feature">
        <div>
          <ShellViewer />
          <dl class="titleblock plate">
            <div><dt>Span</dt><dd>{cell.span_m} m</dd></div>
            <div><dt>Supports</dt><dd>{cell.supports}</dd></div>
            <div><dt>Rise / span</dt><dd>{cell.rise_ratio.toFixed(2)}</dd></div>
            <div><dt>S<sub>a</sub></dt><dd>{cell.sa_g} g</dd></div>
            <div><dt>Mesh</dt><dd>{cell.n} × {cell.n} nodes</dd></div>
            <div><dt>Loads</dt><dd>gravity + seismic</dd></div>
          </dl>
        </div>
        <div class="prose">
          <p>ShellForm solves one cell under gravity, then again with seismic load. Colour marks where the two forms differ.</p>
          <p><a class="btn" href="/work/shellform/">Read the ShellForm case study <span class="arr" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="research" aria-labelledby="sel">
    <div class="railed">
      <div class="section-head">
        <div><span class="idx"><span class="cm" aria-hidden="true">#</span> 02 · Projects</span><h2 id="sel">Flagship research</h2></div>
        <a href="/work/">All {projects.length} projects →</a>
      </div>
      <ol class="index">
        {featured.map((p) => <IndexRow project={p} detail />)}
      </ol>
      <p class="ongoing">Other work: <a href="/work/seismic-shell-floors/">Seismic shell floors</a>, one unreleased 3 m vault bay, no carbon optimum yet. <a href="/work/pavecarbon/">PaveCarbon</a>, laboratory durability carried through to annualised pavement carbon.</p>
    </div>
  </section>

  <section class="section wrap" id="background" aria-labelledby="how">
    <div class="railed">
      <div class="section-head"><div><span class="idx"><span class="cm" aria-hidden="true">#</span> 03 · Record</span><h2 id="how">Background</h2></div></div>
      <div class="now">
        <div>
          <span class="label">Denco Manufacturing, 2024-2026</span>
          <p>Cyclic-durability testing of superelastic NiTi, micro-CNC metrology, and failure analysis.</p>
        </div>
        <div>
          <span class="label">Southwest Petroleum University, 2019-2023</span>
          <p>BEng Civil Engineering (84.05/100, Chinese Government Scholarship, RC seismic thesis 87/100).</p>
        </div>
        <div>
          <span class="label">Technical stack</span>
          <p>OpenSeesPy, CalculiX, Python/PyTorch, Gmsh, Three.js, LaTeX.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/mesh';
</script>
